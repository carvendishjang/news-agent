# ---- Required ----
OPENAI_API_KEY=
TAVILY_API_KEY=

# ---- Model ----
OPENAI_MODEL=gpt-5-mini
# Reasoning effort: minimal | low | medium | high. "low" halves latency vs "medium" with similar ranking quality.
OPENAI_REASONING_EFFORT=low

# ---- HTTP API ----
# Comma-separated API keys clients must send as `x-api-key` or `Authorization: Bearer`.
# Leave empty only for local dev; required when NODE_ENV=production.
API_KEYS=
PORT=8080
HOST=0.0.0.0
# Set true when running behind a load balancer / reverse proxy so client IPs are correct
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_MS=120000
LLM_TIMEOUT_MS=60000
SEARCH_TIMEOUT_MS=20000
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=500

# ---- Agent mode budget ("mode": "agent") ----
AGENT_MAX_SEARCHES=8
AGENT_MAX_STEPS=6
AGENT_MAX_TOKENS=60000
AGENT_MAX_RESEARCH_MS=45000

# ---- Optional: LangSmith tracing ----
LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
LANGSMITH_PROJECT=news-agent
# Uncomment the following if you are on the EU instance:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
